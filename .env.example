# Copy this to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Neon: Dashboard -> Connection Details -> Pooled connection)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin auth (NextAuth) — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ImageKit (product image storage) — this project's files are scoped under IMAGEKIT_APP_FOLDER
# so they stay separate from other galleries on the same ImageKit account.
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/...
IMAGEKIT_APP_FOLDER=apple-store-mbarara

# Stripe (checkout still goes through Stripe in this pass)
STRIPE_PUBLIC=pk_test_...
STRIPE_SECRET=sk_test_...

# Which PaymentProvider adapter to use (server/config/providers.ts). Only "stripe" exists today.
PAYMENT_PROVIDER=stripe

# Used only by scripts/seedAdmin.js to create/update the one admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Currency code for price display (ISO 4217 — e.g. USD, UGX, EUR, GBP)
NEXT_PUBLIC_CURRENCY=USD
